# Copy to .env for local use. NEVER commit a real .env (it is gitignored).
# Production credentials live in AWS Secrets Manager, not here.

# ── Safety ────────────────────────────────────────────────────────────────
# Invariant I12: live trading NEVER defaults ON. Leave false unless you mean it.
TRADING_ENABLED=false
# shadow | tiny_live — operating mode of the trader.
TRADER_MODE=shadow

# ── Venue ─────────────────────────────────────────────────────────────────
# Target venue is POLYMARKET_US (polymarket.us) — the CFTC-regulated DCM/DCO,
# NOT the international on-chain CLOB. Config is validated by @pmbtc/contracts
# parseVenueConfig(), which REJECTS any known international Polymarket endpoint
# (the international CLOB/WS hosts are enumerated in packages/contracts venue.ts).
POLYMARKET_VENUE=POLYMARKET_US

# ── Data feeds ──────────────────────────────────────────────────────────────
# Binance = fast alpha / microstructure driver (predictive only; NEVER settlement
# truth — see Invariant I15).
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOL=btcusdt
# Polymarket US Markets WebSocket + REST (the traded contract). Must be
# polymarket.us hosts; international endpoints are rejected at startup.
POLYMARKET_WS_URL=wss://api.polymarket.us/v1/ws/markets
POLYMARKET_REST_URL=https://api.polymarket.us
# ── Reference / settlement feed ─────────────────────────────────────────────
# CF Benchmarks BRTI is the official resolution reference for the US hourly BTC
# product. Kept separate from Binance; it is settlement truth, Binance is not.
BRTI_SOURCE=CF_BRTI

# ── Persistence ───────────────────────────────────────────────────────────
# Local dev only. In AWS these come from Secrets Manager / task env.
DATABASE_URL=postgres://localhost:5432/pmbtc
S3_RAW_EVENTS_BUCKET=pmbtc-raw-events-dev
AWS_REGION=us-east-1

# ── Hard risk limits (see packages/contracts RiskLimits) ────────────────────
# Milliseconds for the *_AGE / DRIFT ceilings.
MAX_BINANCE_AGE=1500
MAX_POLYMARKET_AGE=2000
MAX_CLOCK_DRIFT=250

# ── Model artifacts ─────────────────────────────────────────────────────────
MODELS_DIR=./models
# Pin the artifact versions the trader is allowed to load.
TOUCH_MODEL_VERSION=v001
STOP_RISK_MODEL_VERSION=v001
CONTINUATION_MODEL_VERSION=v001
